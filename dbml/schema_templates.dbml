// DBML Schema Group: Contract Templates & Form Builder
// Visualizable on dbdiagram.io or DBML Previewer

Table m_template_folders {
  id uuid [pk]
  name varchar [not null]
  parent_id uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_contract_templates {
  id uuid [pk]
  template_folder_id uuid
  name varchar [not null]
  description text
  file_path varchar [not null]
  file_name varchar [not null]
  file_size bigint [default: 0]
  file_type varchar
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_form_templates {
  id uuid [pk]
  name varchar [not null]
  description text
  document_type varchar [default: 'contract']
  contract_type_id uuid
  transaction_type varchar
  has_letterhead boolean [default: false]
  letterhead_json json
  is_active boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_form_fields {
  id uuid [pk]
  form_template_id uuid [not null]
  parent_id uuid
  label varchar [not null]
  name varchar [not null]
  type varchar [not null]
  container_type varchar
  width varchar [default: '100']
  placeholder varchar
  is_required boolean [default: false]
  use_rich_text boolean [default: false]
  options json
  validation_rules json
  order integer [default: 0]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

// Relationships
Ref: m_template_folders.parent_id > m_template_folders.id [delete: cascade]
Ref: m_contract_templates.template_folder_id > m_template_folders.id
Ref: m_form_fields.form_template_id > m_form_templates.id [delete: cascade]
Ref: m_form_fields.parent_id > m_form_fields.id [delete: cascade]

TableGroup templates_forms {
  m_template_folders
  m_contract_templates
  m_form_templates
  m_form_fields
}
