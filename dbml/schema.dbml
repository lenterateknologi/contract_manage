// DBML (Database Markup Language) Schema for Contract Management System
// Visualizable on dbdiagram.io or DBML Previewer extensions

Table t_contracts {
  id uuid [pk]
  contract_no varchar [unique, not null]
  crown_no varchar
  title varchar [not null]
  description text
  contract_date date
  end_date date
  contract_type varchar
  contract_type_id uuid
  contract_type_parent_id uuid
  submission_type_id uuid
  transaction_type varchar
  status varchar
  current_version integer [default: 1]
  workflow_id uuid
  origin_workflow_id uuid
  workflow_step_id uuid
  created_by uuid [not null]
  metadata json
  submitted_at timestamp
  initiated_by_id uuid
  vendor_id uuid
  parent_id uuid
  is_digital_signature boolean
  assigned_pic_id uuid
  assigned_by_id uuid
  received_at timestamp
  assigned_at timestamp
  finished_at timestamp
  closed_at timestamp
  closed_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  Note: "Main transaction table representing a contract request"
}

Table t_contract_meta {
  contract_id uuid [pk]
  kop_topik varchar
  kop_sub_topik varchar
  kop_lampiran varchar
  f1_tujuan text
  f1_sifat varchar
  p1_entity varchar
  p1_signer varchar
  p1_signer_position varchar
  p1_address text
  p2_entity varchar
  p2_signer varchar
  p2_signer_position varchar
  p2_address text
  f2_scope text
  f2_price varchar
  f2_payment varchar
  f2_tenure varchar
  f2_location text
  created_at timestamp
  updated_at timestamp

  Note: "Separated contract metadata table (1:1 relationship) to optimize main table width"
}

Table m_users {
  id uuid [pk]
  name varchar [not null]
  email varchar [unique, not null]
  email_verified_at timestamp
  password varchar [not null]
  username varchar [unique]
  initials varchar
  role varchar
  position varchar
  phone varchar
  bg_color varchar
  text_color varchar
  role_id uuid
  department_id uuid
  is_active boolean [default: true]
  remember_token varchar
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_departments {
  id uuid [pk]
  name varchar [not null]
  code varchar [unique, not null]
  description text
  is_active boolean [default: true]
  company_id uuid
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_roles {
  id uuid [pk]
  name varchar [unique, not null]
  description text
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_companies {
  id uuid [pk]
  name varchar [not null]
  code varchar [unique, not null]
  alias varchar
  address text
  company_group_id uuid
  region_id uuid
  is_active boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_company_groups {
  id uuid [pk]
  name varchar [not null]
  code varchar [unique, not null]
  description text
  is_active boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_regions {
  id uuid [pk]
  name varchar [not null]
  code varchar [unique, not null]
  alias varchar
  description text
  is_active boolean [default: true]
  id_portal_master varchar
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_contract_types {
  id uuid [pk]
  name varchar [unique, not null]
  code varchar [unique, not null]
  description text
  parent_id uuid
  workflow_id uuid
  features json
  f1_input_mechanism varchar [default: 'form']
  f1_form_template_id uuid
  f1_contract_template_id uuid
  f2_input_mechanism varchar [default: 'form']
  f2_form_template_id uuid
  f2_contract_template_id uuid
  is_active boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_contract_statuses {
  id uuid [pk]
  code varchar [unique, not null]
  label varchar [not null]
  color varchar [default: 'gray']
  bg_color varchar
  icon varchar
  description text
  sequence integer [default: 0]
  display_mode varchar [default: 'badge']
  allow_info_edit boolean [default: false]
  allow_reference boolean [default: false]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_vendors {
  id uuid [pk]
  name varchar [not null]
  code varchar [unique, not null]
  email varchar
  phone varchar
  address text
  tax_id varchar
  category varchar
  is_active boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_workflows {
  id uuid [pk]
  name varchar [not null]
  description text
  contract_type varchar [not null]
  department_id uuid
  initiator_type varchar
  sla_drafting_hours integer
  sla_total_hours integer
  sla_cutoff_hour integer
  scope varchar
  workflow_category varchar
  company_group_ids json
  region_ids json
  company_ids json
  approver_roles json
  approver_departments json
  approver_users json
  legal_roles json
  legal_departments json
  legal_users json
  is_default boolean [default: false]
  is_template boolean [default: true]
  is_active boolean [default: true]
  is_tax_involved boolean [default: false]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_workflow_steps {
  id uuid [pk]
  workflow_id uuid [not null]
  step integer [not null]
  step_category varchar [default: 'approval']
  approver_type varchar [default: 'role']
  role_id uuid
  label varchar
  description text
  condition_expression text
  is_optional boolean [default: false]
  optional_label varchar
  uploader_type varchar
  hierarchy_level integer
  company_group_ids json
  region_ids json
  company_ids json
  is_mandatory boolean [default: true]
  is_active boolean [default: true]
  meta json
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_workflow_step_actions {
  id uuid [pk]
  workflow_step_id uuid [not null]
  master_action_id uuid [not null]
  next_step_id uuid
  next_workflow_id uuid
  next_workflow_step_id uuid
  required_fields json
  autofilled_fields json
  signing_parties json
  assignee_config json
  alias varchar
  description text
  is_active boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_master_actions {
  id uuid [pk]
  name varchar [not null]
  code varchar [unique, not null]
  is_active boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table t_approvals {
  id uuid [pk]
  contract_id uuid [not null]
  workflow_step_id uuid [not null]
  user_id uuid
  approver_name varchar
  role varchar [not null]
  job_title varchar
  status varchar [default: 'pending']
  comment text
  sequence integer [default: 0]
  decided_at timestamp
  is_active boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table t_contract_attachments {
  id uuid [pk]
  contract_id uuid [not null]
  label varchar [not null]
  category varchar
  file_name varchar [not null]
  file_path varchar [not null]
  file_type varchar
  uploaded_by uuid [not null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table t_contract_versions {
  id uuid [pk]
  contract_id uuid [not null]
  version_no integer [not null]
  file_name varchar [not null]
  file_path varchar
  document_type varchar
  change_log text
  uploaded_by uuid [not null]
  is_final boolean [default: false]
  file_hash varchar
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table t_contract_messages {
  id uuid [pk]
  contract_id uuid [not null]
  user_id uuid [not null]
  message text [not null]
  read_by json
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table t_contract_form_submissions {
  id uuid [pk]
  contract_id uuid [not null]
  form_template_id uuid [not null]
  document_type varchar [not null]
  current_version integer [default: 1]
  submitted_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_form_templates {
  id uuid [pk]
  name varchar [not null]
  description text
  document_type varchar [default: 'contract']
  contract_type_id uuid
  transaction_type varchar
  has_letterhead boolean [default: false]
  letterhead_json json
  is_active boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_form_fields {
  id uuid [pk]
  form_template_id uuid [not null]
  parent_id uuid
  label varchar [not null]
  name varchar [not null]
  type varchar [not null]
  container_type varchar
  width varchar [default: '100']
  placeholder varchar
  is_required boolean [default: false]
  use_rich_text boolean [default: false]
  options json
  validation_rules json
  order integer [default: 0]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_submission_types {
  id uuid [pk]
  name varchar [not null]
  code varchar [unique, not null]
  description text
  is_active boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_template_folders {
  id uuid [pk]
  name varchar [not null]
  parent_id uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_contract_templates {
  id uuid [pk]
  template_folder_id uuid
  name varchar [not null]
  description text
  file_path varchar [not null]
  file_name varchar [not null]
  file_size bigint [default: 0]
  file_type varchar
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_access_modules {
  id uuid [pk]
  role_id uuid [not null]
  module_id uuid [not null]
  module_group_id uuid
  can_read boolean [default: false]
  can_create boolean [default: false]
  can_update boolean [default: false]
  can_delete boolean [default: false]
  can_approve boolean [default: false]
  sequence integer [default: 0]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_modules {
  id uuid [pk]
  name varchar [not null]
  identifier varchar [unique, not null]
  module_group_id uuid
  icon varchar
  route varchar
  sequence integer [default: 0]
  showed_as_menu boolean [default: true]
  is_active boolean [default: true]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_module_groups {
  id uuid [pk]
  name varchar [unique, not null]
  icon varchar
  sequence integer [default: 0]
  created_by uuid
  updated_by uuid
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_role_module_groups {
  id bigint [pk]
  role_id uuid [not null]
  module_group_id uuid [not null]
  sequence integer [default: 0]
  created_at timestamp
  updated_at timestamp
}

Table m_numbering_formats {
  id uuid [pk]
  name varchar [not null]
  format varchar [not null]
  module varchar [not null]
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table t_forgot_password {
  id uuid [pk]
  email varchar [not null]
  user_id uuid [not null]
  expire_at timestamp [not null]
  redeemed_at timestamp
  token varchar [unique, not null]
  created_at timestamp
  updated_at timestamp
}


// --- Relationships (Foreign Keys) ---

// Contract Meta Separation
Ref: t_contract_meta.contract_id - t_contracts.id [delete: cascade]

// Contract Relations
Ref: t_contracts.contract_type_id > m_contract_types.id
Ref: t_contracts.contract_type_parent_id > m_contract_types.id
Ref: t_contracts.submission_type_id > m_submission_types.id
Ref: t_contracts.workflow_id > m_workflows.id
Ref: t_contracts.workflow_step_id > m_workflow_steps.id
Ref: t_contracts.created_by > m_users.id
Ref: t_contracts.initiated_by_id > m_users.id
Ref: t_contracts.assigned_pic_id > m_users.id
Ref: t_contracts.assigned_by_id > m_users.id
Ref: t_contracts.closed_by > m_users.id
Ref: t_contracts.vendor_id > m_vendors.id
Ref: t_contracts.parent_id > t_contracts.id
Ref: t_contracts.origin_workflow_id > m_workflows.id

// Users & Organization
Ref: m_users.role_id > m_roles.id
Ref: m_users.department_id > m_departments.id
Ref: m_departments.company_id > m_companies.id
Ref: m_companies.company_group_id > m_company_groups.id
Ref: m_companies.region_id > m_regions.id

// Contract Type & Templates
Ref: m_contract_types.parent_id > m_contract_types.id
Ref: m_contract_types.workflow_id > m_workflows.id
Ref: m_contract_types.f1_form_template_id > m_form_templates.id
Ref: m_contract_types.f2_form_template_id > m_form_templates.id
Ref: m_contract_types.f1_contract_template_id > m_contract_templates.id
Ref: m_contract_types.f2_contract_template_id > m_contract_templates.id
Ref: m_form_templates.contract_type_id > m_contract_types.id
Ref: m_form_fields.form_template_id > m_form_templates.id [delete: cascade]
Ref: m_form_fields.parent_id > m_form_fields.id [delete: cascade]

// Workflow Configuration
Ref: m_workflows.department_id > m_departments.id
Ref: m_workflow_steps.workflow_id > m_workflows.id
Ref: m_workflow_steps.role_id > m_roles.id

// Workflow Step Actions
Ref: m_workflow_step_actions.workflow_step_id > m_workflow_steps.id [delete: cascade]
Ref: m_workflow_step_actions.master_action_id > m_master_actions.id [delete: cascade]
Ref: m_workflow_step_actions.next_step_id > m_workflow_steps.id
Ref: m_workflow_step_actions.next_workflow_id > m_workflows.id
Ref: m_workflow_step_actions.next_workflow_step_id > m_workflow_steps.id

// Approvals & Transaction Records
Ref: t_approvals.contract_id > t_contracts.id [delete: cascade]
Ref: t_approvals.workflow_step_id > m_workflow_steps.id
Ref: t_approvals.user_id > m_users.id

Ref: t_contract_attachments.contract_id > t_contracts.id [delete: cascade]
Ref: t_contract_attachments.uploaded_by > m_users.id

Ref: t_contract_versions.contract_id > t_contracts.id [delete: cascade]
Ref: t_contract_versions.uploaded_by > m_users.id

Ref: t_contract_messages.contract_id > t_contracts.id [delete: cascade]
Ref: t_contract_messages.user_id > m_users.id

Ref: t_contract_form_submissions.contract_id > t_contracts.id [delete: cascade]
Ref: t_contract_form_submissions.form_template_id > m_form_templates.id
Ref: t_contract_form_submissions.submitted_by > m_users.id

// Templates Folder Hierarchy
Ref: m_template_folders.parent_id > m_template_folders.id [delete: cascade]
Ref: m_contract_templates.template_folder_id > m_template_folders.id

// Access Control Lists
Ref: m_access_modules.role_id > m_roles.id [delete: cascade]
Ref: m_access_modules.module_id > m_modules.id [delete: cascade]
Ref: m_access_modules.module_group_id > m_module_groups.id
Ref: m_modules.module_group_id > m_module_groups.id
Ref: m_role_module_groups.role_id > m_roles.id [delete: cascade]
Ref: m_role_module_groups.module_group_id > m_module_groups.id [delete: cascade]

// Forgot Password Security
Ref: t_forgot_password.user_id > m_users.id [delete: cascade]
